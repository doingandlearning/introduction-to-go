# Dockerfile.entrypoint-demo — Exercise 5.
#
# A working multi-stage build that runs the server via entrypoint.sh
# instead of invoking the binary directly. Uses alpine (not distroless)
# for the final stage specifically because it needs a shell — this is
# itself a real tradeoff: distroless/scratch have no shell, so any
# container that needs an entrypoint script (health checks before
# start, running migrations, validating env vars) needs a base image
# that has one.
#
# Build and run this once as-is to confirm it works, THEN do the
# damage described in Exercise 5.

# --- build stage ---
FROM golang:1.22 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /server ./cmd/server

# --- final stage ---
FROM alpine:3.19
COPY --from=builder /server /server
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
